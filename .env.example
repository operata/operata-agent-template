# =============================================================================
# Agent — Environment Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then validate your setup:
#   make check
# =============================================================================


# =============================================================================
# REQUIRED — the agent will not run without these
# =============================================================================

# AWS region for Bedrock, AgentCore, Secrets Manager
AWS_REGION=us-west-2

# AWS CLI profile (local dev only — AgentCore uses IAM task roles)
# AWS_PROFILE=your-profile

# Slack — create a bot at https://api.slack.com/apps
# Required scopes: chat:write, channels:history, channels:read, users:read
SLACK_BOT_TOKEN=xoxb-...

# TODO: Add channel IDs for channels in your SLACK_CHANNEL_ENV_MAP
# Get channel IDs from Slack: right-click channel name → View channel details → ID at bottom
# SLACK_CHANNEL_MY_CHANNEL=C01234567


# =============================================================================
# OPTIONAL — agent works without these, with reduced capability
# =============================================================================

# AgentCore Memory — persistent memory across runs
# Create with: python tools/memory_tools.py
# Then paste the memory ID here
AGENTCORE_MEMORY_ID=

# TODO: Add env vars for your data sources. Examples:
#
# Jira — get an API token at https://id.atlassian.com/manage/api-tokens
# JIRA_URL=https://your-org.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=
#
# GitHub — generate a token at https://github.com/settings/tokens
# GITHUB_TOKEN=
# GITHUB_ORG=your-org


# =============================================================================
# AGENT BEHAVIOUR
# =============================================================================

# Set to "true" to suppress all external writes (safe for testing)
DRY_RUN=true
